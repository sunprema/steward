# Copy to tools/stack/.env and adjust. `tools/stack/stack` sources .env if present;
# docker compose reads the same file. Everything here is a local-only default:
# never reuse these passwords outside the local stack.

# Control-plane metadata Postgres (doc 12)
CONTROL_DB_PORT=5433
CONTROL_DB_NAME=steward_control
CONTROL_DB_USER=steward
CONTROL_DB_PASSWORD=steward

# Sample governed target Postgres (doc 17 §11 retail schema)
TARGET_DB_PORT=5434
TARGET_DB_NAME=retail
TARGET_DB_USER=retail
TARGET_DB_PASSWORD=retail

# Least-privilege adapter role created in the target (doc 08 §8)
STEWARD_ADAPTER_PASSWORD=steward_adapter

# MinIO object store
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=steward
MINIO_ROOT_PASSWORD=stewardsteward
MINIO_BUCKET=steward

# Steward components (enabled per milestone; see docker-compose.yml)
PROXY_PORT=5432
ENGINE_GRANT_PORT=8443
CONTROL_HTTP_PORT=4000
CONTROL_GRPC_PORT=50051

# Fixture size loaded into target-db by `stack up` (s|m|l|xl; doc 17 §11)
STEWARD_FIXTURE_SIZE=s
