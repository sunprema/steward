  "custom_indexes": [],
  "custom_statements": [
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP FUNCTION IF EXISTS validate_boundary_json();",
      "global?": false,
      "name": "validate_boundary_json_fn",
      "up": "CREATE OR REPLACE FUNCTION validate_boundary_json() RETURNS trigger AS $BODY$\nDECLARE\n  val jsonb;\nBEGIN\n  val := (row_to_json(NEW)::jsonb) -> TG_ARGV[0];\n  IF val IS NOT NULL AND (\n    jsonb_path_exists(val, '$.**.rows') OR jsonb_path_exists(val, '$.**.row') OR\n    jsonb_path_exists(val, '$.**.sample_keys') OR jsonb_path_exists(val, '$.**.before_image') OR\n    jsonb_path_exists(val, '$.**.after_image') OR jsonb_path_exists(val, '$.**.values') OR\n    jsonb_path_exists(val, '$.**.key') OR jsonb_path_exists(val, '$.**.keys')\n  ) THEN\n    RAISE EXCEPTION 'boundary violation: % contains a banned key', TG_ARGV[0];\n  END IF;\n  RETURN NEW;\nEND;\n$BODY$ LANGUAGE plpgsql;\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER IF EXISTS validate_boundary_json_summary ON changesets;",
      "global?": false,
      "name": "validate_boundary_json_summary",
      "up": "CREATE TRIGGER validate_boundary_json_summary BEFORE INSERT OR UPDATE ON changesets FOR EACH ROW EXECUTE FUNCTION validate_boundary_json('summary');"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER IF EXISTS validate_boundary_json_impact ON changesets;",
      "global?": false,
      "name": "validate_boundary_json_impact",
      "up": "CREATE TRIGGER validate_boundary_json_impact BEFORE INSERT OR UPDATE ON changesets FOR EACH ROW EXECUTE FUNCTION validate_boundary_json('impact');"
    }
  ],
