# EditorConfig for the Steward monorepo (doc 18)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,toml,ts,js,tsx,jsx,ex,exs,heex}]
indent_size = 2

[*.{rs,java,kts,py}]
indent_size = 4

[*.rs]
max_line_length = 100

[Makefile]
indent_style = tab

[*.bat]
end_of_line = crlf
